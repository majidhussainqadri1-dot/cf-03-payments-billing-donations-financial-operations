      "@php -r \"fwrite(STDOUT, 'Historical suites are centrally quarantined in tests/bootstrap.php and retained only as superseded provenance.\\n');\""
    ],
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  }
}
