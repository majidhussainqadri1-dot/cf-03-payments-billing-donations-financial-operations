    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Sabri\\CF03\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "php tests/run.php",
      "php tests/run-new-governing-plans.php",
